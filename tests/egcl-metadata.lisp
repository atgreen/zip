(require :asdf)
(require :egcl-posix)
(defpackage :zip (:use :cl))
;; Read FILE-MODE alone: the regression is its platform dispatch.
(with-open-file (s (merge-pathnames "zip.lisp" *default-pathname-defaults*))
  (loop for form = (read s nil :eof) until (eq form :eof)
        when (and (consp form) (eq (car form) 'defun)
                  (string= (symbol-name (cadr form)) "FILE-MODE"))
          do (let ((*package* (find-package :zip)))
               (eval (read-from-string (prin1-to-string form))))
             (return)))
(with-open-file (s "zip-mode-input" :direction :output :if-exists :supersede)
  (write-string "zip" s))
(egcl-posix:chmod "zip-mode-input" #o640)
(assert (= #o640 (logand #o777 (file-mode "zip-mode-input"))))
(format t "ZIP-MODE-PASS~%")
